<resources>
    <!--
      Tema oscuro FIJO, no DayNight.
      Bug de la v0.1.1: el tema era DayNight y en Android 7 resuelve a claro (no existe el
      modo oscuro del sistema), con textos gris oscuro sobre el fondo negro que forzábamos.
      Los títulos de los ajustes eran ilegibles y Mariano terminó tocando interruptores a ciegas.
    -->
    <style name="Theme.Photoframe" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Ajustes: texto grande y contrastado, para leer el marco a un metro de distancia. -->
    <style name="Theme.Photoframe.Settings" parent="Theme.Photoframe">
        <item name="android:textAppearanceMedium">@style/TextAppearance.Photoframe.Title</item>
        <item name="preferenceTheme">@style/PreferenceTheme.Photoframe</item>
    </style>

    <style name="PreferenceTheme.Photoframe" parent="@style/PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.Photoframe.Category</item>
    </style>

    <style name="TextAppearance.Photoframe.Title" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.Photoframe.Category" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Photoframe.Fullscreen" parent="Theme.Photoframe">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
